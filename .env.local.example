# Copy to .env.local and fill in values for local development.
# These same values go into GitHub Actions secrets (Settings → Secrets → Actions).

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_PROJECT_REF=xxxxxxxxxxxx

GEMINI_API_KEY=AIzaSy...

RESEND_API_KEY=re_...
DIGEST_EMAIL=you@youremail.com

# SEC requires a user-agent identifying your app + contact email
EDGAR_USER_AGENT=OpportunityScout your@email.com

# Alpaca broker execution (US main-book positions). Leave BLANK to keep the
# simulator — the daily run behaves exactly as before when these are absent.
# ALPACA_BASE_URL selects paper vs live; going live is a manual URL/key change.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
